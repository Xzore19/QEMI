OPENQASM 3.0;
include "stdgates.inc";
gate mcx _gate_q_0, _gate_q_1, _gate_q_2, _gate_q_3 {
  h _gate_q_3;
  p(pi/8) _gate_q_0;
  p(pi/8) _gate_q_1;
  p(pi/8) _gate_q_2;
  p(pi/8) _gate_q_3;
  cx _gate_q_0, _gate_q_1;
  p(-pi/8) _gate_q_1;
  cx _gate_q_0, _gate_q_1;
  cx _gate_q_1, _gate_q_2;
  p(-pi/8) _gate_q_2;
  cx _gate_q_0, _gate_q_2;
  p(pi/8) _gate_q_2;
  cx _gate_q_1, _gate_q_2;
  p(-pi/8) _gate_q_2;
  cx _gate_q_0, _gate_q_2;
  cx _gate_q_2, _gate_q_3;
  p(-pi/8) _gate_q_3;
  cx _gate_q_1, _gate_q_3;
  p(pi/8) _gate_q_3;
  cx _gate_q_2, _gate_q_3;
  p(-pi/8) _gate_q_3;
  cx _gate_q_0, _gate_q_3;
  p(pi/8) _gate_q_3;
  cx _gate_q_2, _gate_q_3;
  p(-pi/8) _gate_q_3;
  cx _gate_q_1, _gate_q_3;
  p(pi/8) _gate_q_3;
  cx _gate_q_2, _gate_q_3;
  p(-pi/8) _gate_q_3;
  cx _gate_q_0, _gate_q_3;
  h _gate_q_3;
}
gate iswap _gate_q_0, _gate_q_1 {
  s _gate_q_0;
  s _gate_q_1;
  h _gate_q_0;
  cx _gate_q_0, _gate_q_1;
  cx _gate_q_1, _gate_q_0;
  h _gate_q_1;
}
bit[4] dj_creg;
qubit[9] dj_qreg;
x dj_qreg[8];
h dj_qreg[0];
h dj_qreg[1];
h dj_qreg[2];
h dj_qreg[3];
h dj_qreg[4];
h dj_qreg[5];
h dj_qreg[6];
h dj_qreg[7];
h dj_qreg[8];
cx dj_qreg[0], dj_qreg[8];
ccx dj_qreg[1], dj_qreg[2], dj_qreg[8];
ccx dj_qreg[2], dj_qreg[3], dj_qreg[8];
mcx dj_qreg[1], dj_qreg[2], dj_qreg[3], dj_qreg[8];
crz(-pi) dj_qreg[5], dj_qreg[6];
cx dj_qreg[4], dj_qreg[6];
iswap dj_qreg[5], dj_qreg[7];
rz(-*pi) dj_qreg[6];
rz(0) dj_qreg[6];
h dj_qreg[0];
h dj_qreg[1];
h dj_qreg[2];
h dj_qreg[3];
dj_creg[0] = measure dj_qreg[0];
dj_creg[1] = measure dj_qreg[1];
dj_creg[2] = measure dj_qreg[2];
dj_creg[3] = measure dj_qreg[3];
