OPENQASM 3.0;
include "stdgates.inc";
gate ccz _gate_q_0, _gate_q_1, _gate_q_2 {
  h _gate_q_2;
  ccx _gate_q_0, _gate_q_1, _gate_q_2;
  h _gate_q_2;
}
bit[5] c0;
qubit[5] q0;
ccx q0[4], q0[2], q0[1];
cry(pi/2) q0[2], q0[0];
cz q0[0], q0[1];
cp(pi/8) q0[1], q0[3];
x q0[2];
c0[3] = measure q0[3];
if (c0[3]) {
  rz(pi/8) q0[2];
  rx(pi/4) q0[2];
  z q0[0];
  ch q0[2], q0[0];
  cswap q0[4], q0[3], q0[0];
} else {
  crz(pi/2) q0[2], q0[3];
  ccx q0[3], q0[1], q0[0];
  rz(pi/8) q0[1];
  ch q0[3], q0[1];
  rx(pi/2) q0[0];
}
ccx q0[4], q0[2], q0[1];
ccz q0[4], q0[1], q0[0];
h q0[2];
cswap q0[4], q0[3], q0[1];
ccx q0[4], q0[2], q0[0];
c0[0] = measure q0[0];
c0[1] = measure q0[1];
c0[2] = measure q0[2];
c0[3] = measure q0[3];
c0[4] = measure q0[4];
